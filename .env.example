# Firebase config — copiar a .env.local y rellenar con proyecto real
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo demo: si no hay .env.local con credenciales validas,
# la app corre con datos de demostracion marcados como tales.

# Cuenta de servicio de Google (proxy de video en api/drive-video.ts) — NUNCA en .env.local
# para produccion, solo como variables de entorno en Vercel (Project Settings > Environment
# Variables). Se crean en Google Cloud Console > IAM > Cuentas de servicio, con la API de
# Drive habilitada. Despues comparte la carpeta "AV Control" de Drive con el correo de la
# cuenta de servicio (rol: Lector) para que el proxy pueda leer los videos.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Subidas CENTRALIZADAS (api/drive-upload-session.ts, api/drive-share.ts): en vez de que cada
# quien suba a SU Drive personal, todo se sube al Drive PERSONAL de pablocorona111@gmail.com (no
# es cuenta Workspace, asi que domain-wide delegation no aplica aqui). Setup unico:
#   1. console.cloud.google.com > el mismo proyecto (av-control-grupo-ortiz) > APIs y servicios >
#      Credenciales > Crear credenciales > ID de cliente de OAuth > tipo "Aplicacion web".
#   2. "URI de redireccionamiento autorizados": https://TU-DOMINIO/api/drive-authorize
#   3. Si la pantalla de consentimiento esta en modo "Prueba", agrega pablocorona111@gmail.com
#      como usuario de prueba (si no, Google rechaza el login de esa cuenta).
#   4. Copia el Client ID y Client Secret aqui abajo y en Vercel, y vuelve a desplegar.
#   5. Logueado como pablocorona111@gmail.com, visita https://TU-DOMINIO/api/drive-authorize,
#      acepta el permiso, copia el refresh token que te muestra UNA sola vez.
#   6. Pega ese refresh token en GOOGLE_DRIVE_OWNER_REFRESH_TOKEN (en Vercel) y despliega otra vez.
GOOGLE_DRIVE_OWNER_CLIENT_ID=
GOOGLE_DRIVE_OWNER_CLIENT_SECRET=
GOOGLE_DRIVE_OWNER_REFRESH_TOKEN=

# IMPORTANTE para produccion: api/drive-video.ts y api/drive-thumbnail.ts verifican el ID token
# de Firebase de quien pide el archivo, y para eso necesitan el ID del proyecto EN TIEMPO DE
# EJECUCION (no solo al compilar). Se usa VITE_FIREBASE_PROJECT_ID de arriba, que en Vercel ya
# esta como variable del proyecto y tambien llega a las funciones. Si algun dia solo se define
# al compilar, define ademas FIREBASE_PROJECT_ID con el mismo valor — sin eso las funciones
# responden 500 y ni el video ni las miniaturas cargan.
# FIREBASE_PROJECT_ID=
