rules_version = '2';

// Borrador inicial — validar con Firebase Emulator antes de produccion.
// Ver SECURITY.md para la matriz completa de permisos.
service cloud.firestore {
  match /databases/{database}/documents {

    function usuarioAutenticado() {
      return request.auth != null;
    }

    function datosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return datosUsuario().rol;
    }

    function esSuperadmin() {
      return usuarioAutenticado() && rol() == 'superadmin';
    }

    function esLiderAudiovisual() {
      return usuarioAutenticado() && rol() == 'lider_audiovisual';
    }

    function esAprobadorDepartamental() {
      return usuarioAutenticado() && rol() == 'aprobador_departamental';
    }

    // "community" es un rol de verdad; tambien se respeta el permiso heredado
    // sobre otros roles (asignado via el checkbox de gestor de requisiciones).
    function esGestorRequisiciones() {
      return usuarioAutenticado() &&
        (
          rol() == 'community' ||
          (('gestorRequisiciones' in datosUsuario()) && datosUsuario().gestorRequisiciones.activo == true)
        );
    }

    // --- Sub-permisos granulares del gestor de requisiciones (ver SECURITY.md) ---
    // Solo limitan a quien tiene el permiso DELEGADO encendido (`gestorRequisiciones.activo`).
    // El rol "community" sin mapa de permisos, y cualquier otro rol, no se ven afectados.
    function permisosGestor() {
      return datosUsuario().get('gestorRequisiciones', {});
    }

    function esGestorDelegado() {
      return usuarioAutenticado() && permisosGestor().get('activo', false) == true;
    }

    /** true = no hay restriccion que lo impida (no es gestor delegado, o el permiso esta activo). */
    function gestorPuede(permiso) {
      return !esGestorDelegado() || permisosGestor().get(permiso, false) == true;
    }

    function invitacionDe(correo) {
      return get(/databases/$(database)/documents/invitaciones/$(correo)).data;
    }

    function puedeAprobar() {
      return esSuperadmin() || esLiderAudiovisual() || esAprobadorDepartamental();
    }

    match /usuarios/{usuarioId} {
      allow read: if usuarioAutenticado();

      // Auto-alta: un usuario nuevo puede crear su propio doc solo si existe
      // una invitacion con su correo. El rol Y el permiso de gestor deben
      // coincidir EXACTO con la invitacion — nadie se auto-otorga permisos.
      allow create: if usuarioAutenticado() &&
        request.auth.uid == usuarioId &&
        request.resource.data.correo == request.auth.token.email &&
        request.resource.data.rol == invitacionDe(request.auth.token.email.lower()).rol &&
        request.resource.data.get('gestorRequisiciones', null) ==
          invitacionDe(request.auth.token.email.lower()).get('gestorRequisiciones', null);

      // Cualquiera puede actualizar SU PROPIA foto de perfil (se sincroniza sola con la de
      // Google en cada login) — nada mas ese campo, ni su propio rol ni el de nadie mas.
      // Lider SOLO puede tocar `gestorRequisiciones` de otros — antes podia escribir CUALQUIER
      // campo (incluido `rol`), lo que le permitia autopromoverse o promover a alguien mas a
      // superadmin desde el mismo Select de ConfiguracionPage.tsx que usa para esto.
      allow update: if esSuperadmin() ||
        // Tambien especialidades/puesto: los asigna el lider en Equipo (perfil de trabajo, no permisos).
        (esLiderAudiovisual() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gestorRequisiciones', 'especialidades', 'puesto'])) ||
        (request.auth.uid == usuarioId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl']));
      allow delete: if esSuperadmin() || esLiderAudiovisual();
    }

    match /contadores/{contadorId} {
      allow read: if usuarioAutenticado();
      // Antes cualquier autenticado podia escribir CUALQUIER valor (incluido un numero menor,
      // negativo, o cualquier otro campo) — esto solo deja avanzar el contador en +1 exacto
      // (como hace la transaccion de siguienteFolio() en folio.ts), nunca retrocederlo ni tocar
      // otro campo. Sigue abierto a cualquier autenticado porque solicitante/colaborador tambien
      // generan folios al crear requisiciones/proyectos/guiones/salidas.
      allow write: if usuarioAutenticado() &&
        request.resource.data.keys().hasOnly(['siguiente']) &&
        request.resource.data.siguiente is int &&
        (resource == null || request.resource.data.siguiente == resource.data.siguiente + 1);
    }

    match /invitaciones/{correoId} {
      allow get: if usuarioAutenticado() && request.auth.token.email.lower() == correoId;
      allow read, write: if esSuperadmin() || esLiderAudiovisual();
    }

    match /requisiciones/{reqId} {
      // Las ramas que NO dependen de `resource` (rol, o `verRequisicionesDeOtros`) dejan pasar
      // una query sin `where`. Las que si dependen de `resource` obligan a que la query venga
      // acotada por ese campo — ver `listarRequisiciones()` en requisicionesService.ts.
      allow read: if usuarioAutenticado() && (
        esSuperadmin() || esLiderAudiovisual() || esAprobadorDepartamental() ||
        (esGestorDelegado() && permisosGestor().get('verRequisicionesDeOtros', false) == true) ||
        resource.data.solicitanteId == request.auth.uid ||
        (esGestorRequisiciones() && resource.data.responsableVentaId == request.auth.uid)
      );

      // Sin `crearEnNombreDeTerceros`, el gestor solo puede crear requisiciones a su propio
      // nombre. El resto de roles (solicitante, colaborador, community) ya solo creaban con su
      // propio uid desde la app — quien crea por terceros es el aprobador/lider o el gestor
      // autorizado.
      allow create: if usuarioAutenticado() && (
        request.resource.data.solicitanteId == request.auth.uid ||
        puedeAprobar() ||
        (esGestorDelegado() && permisosGestor().get('crearEnNombreDeTerceros', false) == true)
      );

      // Un gestor no puede aprobar/rechazar, ni auto-asignarse, ni tocar campos restringidos.
      // Ademas: sin `editarDespuesDeEnviar` solo edita mientras sigue en borrador (igual que un
      // solicitante normal), y sin `adjuntarArchivos` no puede tocar adjuntos ni referencias.
      allow update: if usuarioAutenticado() && (
        puedeAprobar() ||
        (
          esGestorRequisiciones() &&
          resource.data.responsableVentaId == request.auth.uid &&
          request.resource.data.estado == resource.data.estado &&
          request.resource.data.responsableVentaId == resource.data.responsableVentaId &&
          request.resource.data.prioridad == resource.data.prioridad &&
          (gestorPuede('editarDespuesDeEnviar') || resource.data.estado == 'borrador') &&
          (
            gestorPuede('adjuntarArchivos') ||
            (
              request.resource.data.get('archivosAdjuntos', []) == resource.data.get('archivosAdjuntos', []) &&
              request.resource.data.get('referenciasVisuales', []) == resource.data.get('referenciasVisuales', [])
            )
          )
        ) ||
        (resource.data.solicitanteId == request.auth.uid && resource.data.estado == 'borrador')
      );

      allow delete: if esSuperadmin();
    }

    match /proyectos/{proyectoId} {
      allow read: if usuarioAutenticado();
      allow create, update, delete: if esSuperadmin() || esLiderAudiovisual();
    }

    match /salidas/{salidaId} {
      allow read: if usuarioAutenticado();
      allow create: if esSuperadmin() || esLiderAudiovisual();
      // Antes el responsable de produccion tambien podia "update" su propia salida sin
      // restriccion de campos — nada en el codigo usa eso hoy (solo existe autorizarSalida(),
      // que escribe `estadoAutorizacion`), asi que esa rama solo servia para que el responsable
      // se autoautorizara su propia salida llamando la API directo, saltandose que la UI le
      // esconde los botones de Autorizar/Rechazar. Solo lider/superadmin deciden.
      allow update: if esSuperadmin() || esLiderAudiovisual();
      allow delete: if esSuperadmin() || esLiderAudiovisual();
    }

    match /entregables/{entregableId} {
      allow read: if usuarioAutenticado();
      allow create: if esSuperadmin() || esLiderAudiovisual();

      // Quien aprueba el VIDEO final es la community (gestor de requisiciones) — no es lo
      // mismo que aprobar la requisicion (`puedeAprobar()`, etapa previa de lider/aprobador
      // departamental). El responsable puede actualizar su entregable (ej. subir link de
      // Drive, mandar a revision) pero nunca puede aprobarse a si mismo.
      allow update: if esSuperadmin() || esGestorRequisiciones() ||
        // Lider: corrige datos del trabajo de su equipo, pero nunca aprueba (estado sin cambios).
        (esLiderAudiovisual() && request.resource.data.estado == resource.data.estado) ||
        (resource.data.responsableId == request.auth.uid && request.resource.data.estado != 'aprobado' &&
          rol() in ['superadmin', 'lider_audiovisual', 'colaborador_audiovisual']);

      allow delete: if esSuperadmin() || esLiderAudiovisual();

      // Solo quien aprueba el VIDEO (community/superadmin) comenta — el responsable (colaborador)
      // solo lee las observaciones y sube de nuevo, no comenta su propio material. Antes esto
      // tambien dejaba comentar a lider/aprobador departamental (puedeAprobar(), pensado para
      // REQUISICIONES) y al propio responsable — ninguno de los dos deberia poder.
      match /comentarios/{comentarioId} {
        allow read: if usuarioAutenticado();
        allow create: if esSuperadmin() || esGestorRequisiciones();
        // El contenido del comentario (texto, autor, momento) sigue sin poder editarse — lo
        // UNICO permitido es que el responsable del entregable marque `corregido` al subir una
        // correccion (ver marcarComentariosCorregidos en entregablesService.ts), para que
        // community vea de una cuales observaciones ya se atendieron. `hasOnly(['corregido'])`
        // garantiza que ningun otro campo cambie en esa escritura.
        allow update: if esSuperadmin() ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['corregido']) &&
            get(/databases/$(database)/documents/entregables/$(entregableId)).data.responsableId == request.auth.uid);
        allow delete: if esSuperadmin();
      }
    }

    match /guiones/{guionId} {
      allow read: if usuarioAutenticado();
      allow create: if esSuperadmin() || esLiderAudiovisual();

      // El redactor edita contenido y lo manda a revision. Solo la community (gestor de
      // requisiciones) o el superadmin aprueban/piden cambios — el lider solo crea/asigna.
      allow update: if esSuperadmin() ||
        (resource.data.responsableId == request.auth.uid && request.resource.data.estado != 'aprobado') ||
        (
          esGestorRequisiciones() &&
          request.resource.data.contenido == resource.data.contenido &&
          request.resource.data.responsableId == resource.data.responsableId
        );

      allow delete: if esSuperadmin() || esLiderAudiovisual();

      // Solo community (o superadmin) comenta — a proposito mas estricto que esGestorRequisiciones()
      // (que tambien incluye el permiso delegado): el redactor (colaborador) nunca comenta su
      // propio guion, solo escribe y manda a revision.
      match /comentarios/{comentarioId} {
        allow read: if usuarioAutenticado();
        allow create: if esSuperadmin() || rol() == 'community';
        allow update: if false;
        allow delete: if esSuperadmin();
      }
    }

    match /equipo_av/{equipoId} {
      allow read: if usuarioAutenticado();
      allow write: if esSuperadmin() || esLiderAudiovisual();
    }

    // Metas/KPI por persona y proyectos a cargo (pestaña "Estructura y KPI"): todos las leen
    // (cada quien ve su meta), solo lider/superadmin las definen.
    match /metas/{usuarioId} {
      allow read: if usuarioAutenticado();
      allow write: if esSuperadmin() || esLiderAudiovisual();
    }

    match /colaboradores/{colaboradorId} {
      allow read: if usuarioAutenticado();
      allow write: if esSuperadmin() || esLiderAudiovisual();
    }

    match /notificaciones/{notifId} {
      // El superadmin tambien puede leer TODAS (no solo las propias) — lo necesita el boton
      // "vaciar toda la info" de Configuracion para poder listar y borrar la coleccion completa.
      allow read: if usuarioAutenticado() && (resource.data.paraUsuarioId == request.auth.uid || esSuperadmin());
      allow create: if usuarioAutenticado();
      // Solo el dueño la marca como leida, y solo ese campo.
      allow update: if usuarioAutenticado() && resource.data.paraUsuarioId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      // El dueño nunca borra (serian sus propias notificaciones) — solo el superadmin, y solo
      // para el boton de "vaciar toda la info" en Configuracion.
      allow delete: if esSuperadmin();
    }

    match /audit_log/{entryId} {
      allow read: if esSuperadmin() || esLiderAudiovisual();
      allow create: if usuarioAutenticado();
      allow update, delete: if false;
    }

    match /notification_log/{entryId} {
      allow read: if esSuperadmin() || esLiderAudiovisual();
      allow write: if false; // solo Cloud Functions (admin SDK) escriben aqui
    }
  }
}
